    ROW ( "measure", "Ending AUM LY", "slice", "year=2024", "value", FORMAT ( CALCULATE ( [Ending AUM LY], dim_date[year] = 2024 ), "0.0000000000" ) ),
    ROW ( "measure", "AUM YoY %", "slice", "year=2024", "value", FORMAT ( CALCULATE ( [AUM YoY %], dim_date[year] = 2024 ), "0.0000000000" ) ),
    ROW ( "measure", "Avg Monthly AUM", "slice", "year=2024", "value", FORMAT ( CALCULATE ( [Avg Monthly AUM], dim_date[year] = 2024 ), "0.0000000000" ) ),
