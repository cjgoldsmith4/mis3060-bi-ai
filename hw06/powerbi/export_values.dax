// HW6 Part B: every required (measure, slice) pair in one result.
// Run in DAX query view, then Copy the result grid into reports/powerbi_values.csv.
// FORMAT keeps 10 decimals and returns an empty string for BLANK.
EVALUATE
UNION (
    ROW ( "measure", "Total Fees", "slice", "Total", "value", FORMAT ( [Total Fees], "0.0000000000" ) ),
    ROW ( "measure", "Net Flows", "slice", "Total", "value", FORMAT ( [Net Flows], "0.0000000000" ) ),
    ROW ( "measure", "AUM (naive SUM)", "slice", "Total", "value", FORMAT ( [AUM (naive SUM)], "0.0000000000" ) ),
    ROW ( "measure", "Ending AUM", "slice", "Total", "value", FORMAT ( [Ending AUM], "0.0000000000" ) ),
    ROW ( "measure", "Ending Clients", "slice", "Total", "value", FORMAT ( [Ending Clients], "0.0000000000" ) ),
    ROW ( "measure", "Avg AUM per Client", "slice", "Total", "value", FORMAT ( [Avg AUM per Client], "0.0000000000" ) ),
    ROW ( "measure", "Ending AUM LY", "slice", "Total", "value", FORMAT ( [Ending AUM LY], "0.0000000000" ) ),
    ROW ( "measure", "AUM YoY %", "slice", "Total", "value", FORMAT ( [AUM YoY %], "0.0000000000" ) ),
    ROW ( "measure", "Ending AUM PM", "slice", "Total", "value", FORMAT ( [Ending AUM PM], "0.0000000000" ) ),
    ROW ( "measure", "AUM MoM %", "slice", "Total", "value", FORMAT ( [AUM MoM %], "0.0000000000" ) ),
    ROW ( "measure", "Avg Monthly AUM", "slice", "Total", "value", FORMAT ( [Avg Monthly AUM], "0.0000000000" ) ),
    ROW ( "measure", "Fee Yield (bps)", "slice", "Total", "value", FORMAT ( [Fee Yield (bps)], "0.0000000000" ) ),
    ROW ( "measure", "Organic Growth Rate", "slice", "Total", "value", FORMAT ( [Organic Growth Rate], "0.0000000000" ) ),
    ROW ( "measure", "AUM-Weighted Alpha", "slice", "Total", "value", FORMAT ( [AUM-Weighted Alpha], "0.0000000000" ) ),
    ROW ( "measure", "Alpha Signal", "slice", "Total", "value", [Alpha Signal] ),
    ROW ( "measure", "Top 10 Client Share", "slice", "Total", "value", FORMAT ( [Top 10 Client Share], "0.0000000000" ) ),
    ROW ( "measure", "AUM (naive SUM)", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [AUM (naive SUM)], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "Ending AUM", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [Ending AUM], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "Ending AUM LY", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [Ending AUM LY], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "AUM YoY %", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [AUM YoY %], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "Avg Monthly AUM", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [Avg Monthly AUM], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "Fee Yield (bps)", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [Fee Yield (bps)], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "Organic Growth Rate", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [Organic Growth Rate], dim_date[year] = 2020 ), "0.0000000000" ) ),
    ROW ( "measure", "AUM-Weighted Alpha", "slice", "year=2020", "value", FORMAT ( CALCULATE ( [AUM-Weighted Alpha], dim_date[year] = 2020 ), "0.0000000000" ) ),
