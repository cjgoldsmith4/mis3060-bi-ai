    ROW ( "measure", "Fee Yield (bps)", "slice", "year=2022", "value", FORMAT ( CALCULATE ( [Fee Yield (bps)], dim_date[year] = 2022 ), "0.0000000000" ) ),
    ROW ( "measure", "Organic Growth Rate", "slice", "year=2022", "value", FORMAT ( CALCULATE ( [Organic Growth Rate], dim_date[year] = 2022 ), "0.0000000000" ) ),
